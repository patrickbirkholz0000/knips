{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knips",
  "version": "0.1.0",
  "identifier": "de.birkgroup.knips",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Patrick Birkholz",
    "copyright": "© 2026 Patrick Birkholz",
    "category": "Utility",
    "shortDescription": "Screenshots und Bildschirmaufnahmen mit Zensur",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["knips"] }
    }
  }
}
